galoyAgents:
  image:
    digest: "${image_digest}"
    tag: ""
  secretChecksum: "${secret_checksum}"
  config:
    server:
      secureCookies: true
      mcpEndpoint: "https://dashboard.agents.galoy.io/mcp"
      tunnel:
        deployments:
%{ for deployment_id, public_key in tunnel_deployments ~}
          ${deployment_id}: |
            ${replace(chomp(public_key), "\n", "\n            ")}
%{ endfor ~}
    oauth:
      githubClientId: "Ov23livtQjMQ1fB0toPF"
      githubRedirectUri: "https://dashboard.agents.galoy.io/auth/github/callback"
      githubAllowedTeams:
        - "GaloyMoney/galoy-devs"
        - "GaloyMoney/galoy-business"
    # `providers` and `defaultChain` inherit from charts/drua/values.yaml
    # (gpt-5-mini primary → deepseek-v3.2 fallback).
    agents:
      projectLead:
        compaction:
          resetTimeDeltaSeconds: 3600
          pruneAfterSeconds: 300
      agent:
        compaction:
          pruneAfterSeconds: 300
    report:
      enabled: true
    library:
      dataDir: "/data/library"
      repoUrl: "https://github.com/GaloyMoney/drua-library"
    codeAssistant:
      dbPath: "/data/code-assistant/code-assistant.db"
    concourse:
      enabled: true
      url: "https://ci.galoy.io"
      team: "dev"
    zenduty:
      enabled: true
      defaultTeam: "c634c1cb-405d-451f-a83b-23fa06475e89"
    compose:
      maxToolCalls: 1000
      ## 32 MiB per inner-tool result — sized for realistic Concourse
      ## build logs (35–60 min builds typically 10–30 MiB).
      maxToolResultBytes: "33554432"
      maxReturnBytes: "262144"
      ## JS heap kept at ≥ 2× the per-tool cap so scripts have working
      ## room for split / filter / sort over the parsed payload.
      memoryLimitBytes: "67108864"
      stackLimitBytes: "1048576"
      defaultTimeoutMs: 120000
      maxTimeoutMs: 300000
    githubApp:
      enabled: true
      clientId: "Iv23liCAm3yHFqmGmayW"
      installationId: "123146136"
    ## Smart-HTTP git proxy — sandbox `git clone` / `git push` traffic
    ## flows through drua via the projected SA token; the App-
    ## installation token never crosses the trust boundary. Per memo
    ## 019dfebc. `allowedPushRefs: [refs/heads/bot/*]` keeps agents
    ## off `main` / release branches — agents PR, humans / CI merge.
    gitProxy:
      mirrorRoot: "/data/git-proxy-mirrors"
      mirrorTtlSeconds: 300
      allowlist:
        entries:
          - owner: GaloyMoney
            repo: drua
            modes: [pull, push]
            allowedPushRefs:
              - refs/heads/bot/*
          - owner: GaloyMoney
            repo: lana-bank
            modes: [pull, push]
            allowedPushRefs:
              - refs/heads/bot/*
          - owner: GaloyMoney
            repo: es-entity
            modes: [pull, push]
            allowedPushRefs:
              - refs/heads/bot/*
          - owner: GaloyMoney
            repo: cala
            modes: [pull, push]
            allowedPushRefs:
              - refs/heads/bot/*
          - owner: GaloyMoney
            repo: obix
            modes: [pull, push]
            allowedPushRefs:
              - refs/heads/bot/*
          - owner: GaloyMoney
            repo: job
            modes: [pull, push]
            allowedPushRefs:
              - refs/heads/bot/*
          - owner: GaloyMoney
            repo: citadelbanking-portal
            modes: [pull, push]
            allowedPushRefs:
              - refs/heads/bot/*
    mcpUpstreams:
      - name: honeycomb
        url: https://mcp.honeycomb.io/mcp
        category: observability
        categoryDescription: "Distributed traces, SLOs, and query analysis"
      - name: github
        url: https://api.githubcopilot.com/mcp/
        toolPrefix: github
        authMode: github_app
        category: source-control
        categoryDescription: "GitHub repositories, pull requests, issues, and code search"
        allowedTools:
          - get_file_contents
          - get_commit
          - list_commits
          - list_branches
          - search_code
          - search_repositories
          - pull_request_read
          - list_pull_requests
          - search_pull_requests
          - issue_read
          - list_issues
          - search_issues
      - name: github_actions
        url: https://api.githubcopilot.com/mcp/
        toolPrefix: github_actions
        authMode: github_app
        category: ci
        categoryDescription: "GitHub Actions workflows, runs, jobs, and logs"
        allowedTools:
          - actions_list
          - actions_get
          - get_job_logs
      # PR-mutation upstream — gated to internal agents (project_lead /
      # agent / workflow_step_agent) only. Users and ExportedAgents
      # don't see it. `merge_pull_request` deliberately excluded — the
      # heal-flow guardrail forbids merges.
      - name: github_pull_requests
        url: https://api.githubcopilot.com/mcp/
        toolPrefix: github_pr
        authMode: github_app
        category: source-control-write
        categoryDescription: "GitHub PR mutations — create"
        internalOnly: true
        allowedTools:
          - create_pull_request
          - update_pull_request
          - pull_request_review_write
      - name: github_issues
        url: https://api.githubcopilot.com/mcp/
        toolPrefix: github_issues
        authMode: github_app
        category: source-control-write
        categoryDescription: "GitHub issue mutations — create + comments"
        internalOnly: true
        allowedTools:
          - create_issue
          - add_issue_comment
  postgresMcp:
    enabled: true
    databaseUrlSecret:
      key: pg-mcp-uri
  ingress:
    enabled: true
    host: dashboard.agents.galoy.io
    ingressClassName: traefik
    annotations:
      cert-manager.io/cluster-issuer: letsencrypt-issuer
    tls:
      - hosts:
          - dashboard.agents.galoy.io
        secretName: galoy-agents-tls
  secrets:
    create: false
  resources:
    requests:
      cpu: 100m
      memory: 512Mi
    limits:
      memory: 1Gi
  tracing:
    serviceName: galoy-agents
    sandboxServiceName: galoy-agents-sandbox
    otelExporterOtlpEndpoint: "http://opentelemetry-collector.galoy-agents-otel.svc.cluster.local:4317"

sandbox:
  enabled: true
  installController: false
  namespace: galoy-agents-sandboxes
  controllerNamespace: galoy-agents-sandbox-controller
  createNamespace: false
  templateName: agent-sandbox
  runtimeClassName: gvisor
  networkPolicyManagement: Unmanaged
  image:
    repository: us.gcr.io/galoyorg/sandbox
    digest: "${sandbox_image_digest}"
    tag: ""
  persistence:
    mountPath: /workspace
    size: 10Gi
    storageClassName: standard-rwo
    nixStore:
      enabled: true
      size: 50Gi
      storageClassName: standard-rwo
  nixSubstituters:
%{ if lana_bank_cachix_enabled ~}
  - url: https://lana-bank-github-actions.cachix.org
    publicKey: ${lana_bank_cachix_public_key}
%{ endif ~}
  - url: https://galoy-agents.cachix.org
    publicKey: galoy-agents.cachix.org-1:wGb5wYMLJ3yPYoOvf2O5vt9gEZEJ7hHsqDCNPMELGPY=
%{ if lana_bank_cachix_enabled ~}
  nixNetrc:
    enabled: true
    mountPath: /etc/nix/netrc
    secret:
      create: false
      name: sandbox-nix-netrc
      key: netrc
%{ endif ~}
  mcpGatewayUrl: "http://galoy-agents.galoy-agents.svc.cluster.local:5254/mcp"

kubernetes-mcp-server:
  enabled: true

postgresql:
  enabled: false
