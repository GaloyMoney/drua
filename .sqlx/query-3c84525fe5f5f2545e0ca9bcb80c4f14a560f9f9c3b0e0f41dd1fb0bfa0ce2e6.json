  "db_name": "PostgreSQL",
  "query": "WITH entities AS (SELECT * FROM session_threads WHERE (session_id = ANY($1)) AND deleted = FALSE) SELECT i.id AS \"entity_id: SessionThreadId\", e.sequence, e.event, CASE WHEN $2 THEN e.context ELSE NULL::jsonb END as \"context: es_entity::ContextData\", e.recorded_at FROM entities i JOIN session_thread_events e ON i.id = e.id ORDER BY e.id, e.sequence",
