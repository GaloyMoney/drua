  "db_name": "PostgreSQL",
  "query": "WITH entities AS (SELECT id FROM mcp_creds WHERE owner_id = $1 AND (id > $3) ORDER BY id ASC LIMIT $2) SELECT i.id AS \"entity_id: Repo__Id\", e.sequence, e.event, CASE WHEN $4 THEN e.context ELSE NULL::jsonb END as \"context: es_entity::ContextData\", e.recorded_at, NULL::jsonb as \"forgettable_payload?\" FROM entities i JOIN mcp_cred_events e ON i.id = e.id ORDER BY i.id asc, i.id, e.sequence",
