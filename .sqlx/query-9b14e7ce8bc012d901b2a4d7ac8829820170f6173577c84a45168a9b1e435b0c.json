{
  "db_name": "PostgreSQL",
  "query": "WITH entities AS (SELECT token_hash, id FROM mcp_creds ORDER BY token_hash DESC, id DESC LIMIT $1) SELECT i.id AS \"entity_id: Repo__Id\", e.sequence, e.event, CASE WHEN $2 THEN e.context ELSE NULL::jsonb END as \"context: es_entity::ContextData\", e.recorded_at, NULL::jsonb as \"forgettable_payload?\" FROM entities i JOIN mcp_cred_events e ON i.id = e.id ORDER BY i.token_hash desc, i.id desc, i.id, e.sequence",
