{
  "db_name": "PostgreSQL",
  "query": "WITH entities AS (SELECT id FROM notes WHERE project_id = $1 AND space_id = $2 AND deleted = FALSE ORDER BY id DESC LIMIT $3) SELECT i.id AS \"entity_id: Repo__Id\", e.sequence, e.event, CASE WHEN $4 THEN e.context ELSE NULL::jsonb END as \"context: es_entity::ContextData\", e.recorded_at, NULL::jsonb as \"forgettable_payload?\" FROM entities i JOIN note_events e ON i.id = e.id ORDER BY i.id desc, i.id, e.sequence",
