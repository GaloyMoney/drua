  "query": "SELECT doc_id,\n                      doc_type,\n                      scope_id, scope_slug, name, path, content\n               FROM library_documents\n               WHERE search_tsv @@ plainto_tsquery('english', $1)\n                 AND ($2::text IS NULL OR doc_type = $2)\n               ORDER BY ts_rank(search_tsv, plainto_tsquery('english', $1)) DESC\n               LIMIT $3",
