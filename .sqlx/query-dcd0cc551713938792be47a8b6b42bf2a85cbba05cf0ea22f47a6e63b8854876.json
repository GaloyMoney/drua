  "query": "WITH entities AS (SELECT id FROM workflow_runs WHERE definition_id = $1 AND deleted = FALSE) SELECT i.id AS \"entity_id: Repo__Id\", e.sequence, e.event, CASE WHEN $2 THEN e.context ELSE NULL::jsonb END as \"context: es_entity::ContextData\", e.recorded_at FROM entities i JOIN workflow_run_events e ON i.id = e.id ORDER BY i.id, e.sequence",
