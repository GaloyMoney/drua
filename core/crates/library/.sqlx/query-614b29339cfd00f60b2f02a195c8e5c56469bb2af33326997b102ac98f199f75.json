  "query": "SELECT doc_id,\n                          doc_type,\n                          scope_id, scope_slug, name, path, content\n                   FROM library_documents\n                   WHERE embedding IS NOT NULL\n                     AND ($2::bool = false OR scope_id = ANY($3) OR scope_id IS NULL)\n                     AND ($4::bool = false OR doc_type = ANY($5))\n                   ORDER BY embedding <=> $1\n                   LIMIT $6",
